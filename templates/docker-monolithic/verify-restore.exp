#!/usr/bin/expect -f

# Restores the most recent backup/app-* archive, answering the prompts that restore.sh asks along the way.
# Backups in the default (docker volume) format restore without any database prompts; portable backups
# (backup.sh --portable) are restored by app:restore, which asks for the database connection details.

set timeout -1

set script_dir [file dirname [file normalize [info script]]]
spawn bash "$script_dir/restore.sh"

match_max 100000

set hostname "127.0.0.1"
set port "3306"
set name "supportpal"
set username ""
set password ""

# Reads the database credentials generated by the freshly started container.
proc load_credentials {} {
    global username password
    set container_env [exec docker exec supportpal sudo cat /etc/container_environment.sh]
    regexp {MYSQL_USER='?([^'\n]+)'?} $container_env -> username
    regexp {MYSQL_PASSWORD='?([^'\n]+)'?} $container_env -> password
}

set prompting 0

expect {
    # The backup will be restored to /home/ubuntu/supportpal_1745573480_17734. Do you want to proceed? [Y/n]
    -re {The backup will be restored to .+} {
        send "Y\r"
        exp_continue
    }
    # Container with name 'supportpal' already exists. Do you want to remove that container? [Y/n]
    "Container with name 'supportpal' already exists*" {
        send "Y\r"
        exp_continue
    }
    # The following docker volumes already exist and will be replaced: ... Do you want to proceed? [Y/n]
    "already exist and will be replaced*" {
        send "Y\r"
        exp_continue
    }
    # Hostname [127.0.0.1]:
    -re {Hostname \[[^\]]*\]:} {
        set prompting 1
        load_credentials
        send -- "$hostname\r"
        exp_continue
    }
    # Port [3306]:
    -re {Port \[[^\]]*\]:} {
        send -- "$port\r"
        exp_continue
    }
    # Database [supportpal]:
    -re {Database \[[^\]]*\]:} {
        send -- "$name\r"
        exp_continue
    }
    # Username [supportpal]:
    -re {Username \[[^\]]*\]:} {
        send -- "$username\r"
        exp_continue
    }
    # Password:
    # restore.sh also prints "Password: <value>" before the prompts, so only answer once prompting has started.
    "Password:" {
        if {$prompting} {
            send -- "$password\r"
        }
        exp_continue
    }
    eof
}

# Capture the exit status of the spawned process
catch wait result
set exit_code [lindex $result 3]

# Check if the restore script exited successfully
if {$exit_code == 0} {
    puts "Restore completed successfully with exit code 0"
    exit 0
} else {
    puts "ERROR: Restore failed with exit code $exit_code"
    exit 1
}
