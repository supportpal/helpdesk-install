#!/usr/bin/expect -f

# Restores the most recent backup/volumes-* or backup/app-* archive, answering the prompts that restore.sh asks along
# the way.
# Backups in the default (docker volume) format restore without any database prompts; portable backups
# (backup.sh --portable) are restored by app:restore, which asks for the database connection details.

# Fail rather than hang if restore.sh stops producing output.
set timeout 600

set script_dir [file dirname [file normalize [info script]]]
spawn bash "$script_dir/restore.sh"

match_max 100000

set hostname "127.0.0.1"
set port "3306"
set name "supportpal"
set username ""
set password ""

# Set once app:restore starts prompting, so that the credentials printed by restore.sh beforehand are not mistaken
# for prompts (and vice versa).
set prompting 0

expect {
    # Every confirmation (restore path, existing container, existing volumes) ends with the same prompt.
    "Do you want to proceed?*" {
        send "Y\r"
        exp_continue
    }
    # restore.sh prints the credentials generated by the freshly started container before app:restore asks for them:
    #   Username: iedoh2aiPho7ziub
    #   Password: eiZ2aeTh5ughaexebaenieth9oog8uey
    # The trailing newline ensures the whole value has been received before it is captured.
    -re {Username: ([a-zA-Z0-9]{10,})\r?\n} {
        if {!$prompting} {
            set username $expect_out(1,string)
        }
        exp_continue
    }
    -re {Password: ([a-zA-Z0-9]{10,})\r?\n} {
        if {!$prompting} {
            set password $expect_out(1,string)
        }
        exp_continue
    }
    # app:restore colours its prompts and prefixes them with a space, for example:
    #   " \e[32mHostname\e[39m [\e[33m127.0.0.1\e[39m]:"
    # so the patterns allow ANSI escape sequences around the words. The leading space distinguishes the Password
    # prompt from the "Password: <value>" line printed by restore.sh.
    -re { (?:\x1b\[[0-9;]*m)*Hostname(?:\x1b\[[0-9;]*m)* \[[^\]]*\]:} {
        if {$username eq "" || $password eq ""} {
            puts "\nERROR: app:restore asked for credentials before restore.sh printed them"
            exit 1
        }
        set prompting 1
        send -- "$hostname\r"
        exp_continue
    }
    # Port [3306]:
    -re { (?:\x1b\[[0-9;]*m)*Port(?:\x1b\[[0-9;]*m)* \[[^\]]*\]:} {
        send -- "$port\r"
        exp_continue
    }
    # Database [supportpal]:
    -re { (?:\x1b\[[0-9;]*m)*Database(?:\x1b\[[0-9;]*m)* \[[^\]]*\]:} {
        send -- "$name\r"
        exp_continue
    }
    # Username [supportpal]:
    -re { (?:\x1b\[[0-9;]*m)*Username(?:\x1b\[[0-9;]*m)* \[[^\]]*\]:} {
        send -- "$username\r"
        exp_continue
    }
    # Password:
    -re { (?:\x1b\[[0-9;]*m)*Password(?:\x1b\[[0-9;]*m)*:} {
        if {$prompting} {
            send -- "$password\r"
        }
        exp_continue
    }
    timeout {
        puts "\nERROR: timed out waiting for restore.sh"
        exit 1
    }
    eof
}

# Capture the exit status of the spawned process
catch wait result
set exit_code [lindex $result 3]

# Check if the restore script exited successfully
if {$exit_code == 0} {
    puts "Restore completed successfully with exit code 0"
    exit 0
} else {
    puts "ERROR: Restore failed with exit code $exit_code"
    exit 1
}
